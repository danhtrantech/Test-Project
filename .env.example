# ── Required ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
NOTION_API_KEY=secret_...

# ── Notion Database IDs ──────────────────────────────────────
# The database where new/uncategorized pages land (inbox)
NOTION_INBOX_DATABASE_ID=
# The database where tasks with deadlines live
NOTION_TASKS_DATABASE_ID=

# ── Claude Model ─────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Schedule (minutes) ──────────────────────────────────────
INBOX_TRIAGE_INTERVAL=15
DEADLINE_CHECK_INTERVAL=30
STALE_ARCHIVE_INTERVAL=1440

# ── Weekly Digest ────────────────────────────────────────────
# Day of week (0=Monday, 6=Sunday)
WEEKLY_DIGEST_DAY=0
WEEKLY_DIGEST_HOUR=9

# ── Stale Page Threshold (days) ─────────────────────────────
STALE_DAYS=30

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
