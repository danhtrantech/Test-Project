# ---------------------------------------------------------------------------
# Copy to .env for local development. On Render, set these in the dashboard
# under Environment instead. See README.md for where each value comes from.
# ---------------------------------------------------------------------------

# Public origin of this server, no trailing slash. Used to build the SMS link.
# On Render you can leave this blank — RENDER_EXTERNAL_URL is filled in for you.
PUBLIC_BASE_URL=

# --- Google -----------------------------------------------------------------
# One API key with Geocoding API + Distance Matrix API enabled.
GOOGLE_MAPS_API_KEY=

# The calendar you want polled — normally your Google account email address.
GOOGLE_CALENDAR_ID=you@example.com

# The entire service account JSON key file, pasted as a single line,
# or the same file base64-encoded.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Quo (formerly OpenPhone) ----------------------------------------------
QUO_API_KEY=
# Your Quo number in E.164 format.
QUO_FROM_NUMBER=+15555550123
# Older accounts may still be on the legacy host: https://api.openphone.com/v1
QUO_API_BASE=https://api.quo.com/v1

# --- Security ---------------------------------------------------------------
# Shared secret OwnTracks sends with every location update. Make it long.
OWNTRACKS_SECRET=
# Protects /api/admin/* . Make it long.
ADMIN_TOKEN=

# --- Behaviour (all optional) ----------------------------------------------
# Minutes before the appointment that the SMS goes out.
LEAD_MINUTES=60
# Arrival radius in metres.
GEOFENCE_METERS=100
# Floor between Distance Matrix calls per session, in seconds (cost control).
ETA_MIN_INTERVAL_SECONDS=25
# Sessions are force-expired this long after the appointment start time.
SESSION_MAX_AGE_MINUTES=180
# Assumed country code for 10-digit numbers in calendar notes.
DEFAULT_COUNTRY_CODE=+1
# Timezone used for cron scheduling and log timestamps.
TIMEZONE=America/Los_Angeles
# Where the session file is written.
DATA_DIR=./data
# {{link}} is replaced with the unique tracking URL.
SMS_TEMPLATE=I will be arriving soon. Track my live location and ETA here: {{link}}
# Set to true to run the full pipeline without actually sending any SMS.
DRY_RUN=false
